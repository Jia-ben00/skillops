{
  "id": "docs",
  "name": "SkillBench · 文档处理套件",
  "description": "面向文档/PDF/知识库处理类技能的静态质量门禁。权重合计 100。",
  "agentTask": "请阅读 {dir}/SKILL.md，说明：1) 它处理什么格式的文档；2) 输出物形态；3) 是否有明确的失败处理。",
  "checks": [
    { "id": "frontmatter_valid", "name": "frontmatter 有效且含 name", "weight": 15 },
    { "id": "has_description", "name": "有 description", "weight": 10 },
    { "id": "desc_informative", "name": "描述信息量足够（≥40 字符）", "weight": 10 },
    { "id": "desc_within_limit", "name": "描述 ≤ 1536 字符", "weight": 10 },
    { "id": "lines_within_limit", "name": "SKILL.md ≤ 500 行", "weight": 15 },
    { "id": "has_example", "name": "包含使用示例或代码块", "weight": 15 },
    { "id": "has_references", "name": "有 supporting files（渐进式披露）", "weight": 10 },
    { "id": "trigger_keywords", "name": "描述含触发词", "weight": 5 },
    { "id": "license_or_source", "name": "有 license / 版本 / 仓库信息", "weight": 10 }
  ]
}
